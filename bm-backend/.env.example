PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
IN_MEMORY=false
PASSWORD_KEY_BYTES=64
# Run `neon env pull` to add DATABASE_URL, DATABASE_URL_UNPOOLED, and NEON_BRANCH.
# Filebase S3-compatible storage for images embedded in notes.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
FILEBASE_BUCKET=
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
