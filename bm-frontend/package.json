{
    "name": "bm-frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "format": "oxfmt src vite.config.ts index.html README.md package.json tsconfig.json tsconfig.app.json tsconfig.node.json",
        "format:check": "oxfmt --check src vite.config.ts index.html README.md package.json tsconfig.json tsconfig.app.json tsconfig.node.json",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.5.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
